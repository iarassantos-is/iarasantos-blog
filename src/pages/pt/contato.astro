---
// src/pages/pt/contato.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contato — Iara Santos"
  description="Entre em contato com Iara Santos, designer de interiores e iluminação baseada em Belo Horizonte, disponível para trabalho remoto."
  locale="pt"
>
  <main class="contact-page">
    <header class="contact-header">
      <p class="contact-eyebrow">Contato</p>
      <h1>Vamos conversar sobre o seu projeto.</h1>
      <p class="contact-intro">
        Se você é um estúdio explorando colaboração, um recrutador com uma oportunidade remota,
        ou um designer que quer trocar ideias — quero ouvir você.
      </p>
    </header>

    <div class="contact-grid">

      <!-- Form -->
      <section class="contact-form-section">
        <form
          action="https://formspree.io/f/xvzlljye"
          method="POST"
          class="contact-form"
        >
          <div class="field">
            <label for="name">Nome</label>
            <input type="text" id="name" name="name" required autocomplete="name" />
          </div>

          <div class="field">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" required autocomplete="email" />
          </div>

          <div class="field">
            <label for="subject">Assunto</label>
            <input type="text" id="subject" name="subject" />
          </div>

          <div class="field">
            <label for="message">Mensagem</label>
            <textarea id="message" name="message" rows="6" required></textarea>
          </div>

          <button type="submit" class="submit-btn">Enviar mensagem</button>
        </form>
      </section>

      <!-- Direct contacts -->
      <aside class="contact-aside">

        <div class="contact-block">
          <p class="aside-label">Email</p>
          <a href="mailto:iarasantos.is@icloud.com" class="aside-link">
            iarasantos.is@icloud.com
          </a>
        </div>

        <div class="contact-block">
          <p class="aside-label">LinkedIn</p>
          <a
            href="https://linkedin.com/in/arqiarassantos"
            target="_blank"
            rel="noopener noreferrer"
            class="aside-link"
          >
            linkedin.com/in/arqiarassantos
          </a>
        </div>

        <div class="contact-block">
          <p class="aside-label">Instagram</p>
          <a
            href="https://www.instagram.com/iara_interiordesigner"
            target="_blank"
            rel="noopener noreferrer"
            class="aside-link instagram-link"
          >
            <svg class="inline-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
              <circle cx="12" cy="12" r="4"/>
              <circle cx="17.5" cy="6.5" r="0.5" fill="currentColor" stroke="none"/>
            </svg>
            @iara_interiordesigner
          </a>
        </div>

        <div class="contact-block">
          <p class="aside-label">Localização</p>
          <p class="aside-text">Belo Horizonte, Brasil<br/>Disponível para remoto · Relocation possível</p>
        </div>

        <div class="contact-block">
          <p class="aside-label">Tempo de resposta</p>
          <p class="aside-text">Até 48 horas em dias úteis.</p>
        </div>

      </aside>
    </div>
  </main>
</BaseLayout>

<style>
  .contact-page {
    max-width: var(--content-width, 1100px);
    margin: 0 auto;
    padding: 4rem 2rem 6rem;
  }

  .contact-header {
    max-width: 600px;
    margin-bottom: 4rem;
  }

  .contact-eyebrow {
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-bronze, #8B7355);
    margin: 0 0 1rem;
  }

  .contact-header h1 {
    font-family: var(--font-serif, 'Cormorant Garamond', serif);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 400;
    color: var(--color-ink, #1A1815);
    line-height: 1.15;
    margin: 0 0 1.25rem;
  }

  .contact-intro {
    font-size: 0.95rem;
    color: var(--color-charcoal, #3A3530);
    line-height: 1.7;
    margin: 0;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 5rem;
    align-items: start;
  }

  @media (max-width: 780px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  label {
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-charcoal, #3A3530);
  }

  input,
  textarea {
    border: none;
    border-bottom: 1px solid var(--color-sand, #D4C5B0);
    background: transparent;
    padding: 0.5rem 0;
    font-family: var(--font-sans, 'Inter', sans-serif);
    font-size: 0.9rem;
    color: var(--color-ink, #1A1815);
    outline: none;
    resize: vertical;
    transition: border-color 0.2s ease;
  }

  input:focus,
  textarea:focus {
    border-color: var(--color-bronze, #8B7355);
  }

  .submit-btn {
    align-self: flex-start;
    background: none;
    border: 1px solid var(--color-ink, #1A1815);
    color: var(--color-ink, #1A1815);
    font-family: var(--font-sans, 'Inter', sans-serif);
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.75rem 2rem;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease;
    margin-top: 0.5rem;
  }

  .submit-btn:hover {
    background: var(--color-ink, #1A1815);
    color: var(--color-bone, #F5F2ED);
  }

  .contact-aside {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding-top: 0.25rem;
  }

  .contact-block {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .aside-label {
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-bronze, #8B7355);
    margin: 0;
  }

  .aside-link {
    font-size: 0.875rem;
    color: var(--color-ink, #1A1815);
    text-decoration: none;
    transition: color 0.2s ease;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .aside-link:hover {
    color: var(--color-bronze, #8B7355);
  }

  .aside-text {
    font-size: 0.875rem;
    color: var(--color-charcoal, #3A3530);
    margin: 0;
    line-height: 1.6;
  }

  .inline-icon {
    width: 0.95rem;
    height: 0.95rem;
    flex-shrink: 0;
  }
</style>
