---
// Footer.astro
// Detect current locale from URL
const pathname = Astro.url.pathname;
const isPT = pathname.startsWith('/pt');

const t = {
  en: {
    tagline: "Interiors and light, considered.",
    location: "Belo Horizonte · Open to remote",
    rights: "All rights reserved.",
    nav: {
      blog: "Blog",
      portfolios: "Portfolios",
      about: "About",
      contact: "Contact",
    }
  },
  pt: {
    tagline: "Interiores e luz, com intenção.",
    location: "Belo Horizonte · Disponível para remoto",
    rights: "Todos os direitos reservados.",
    nav: {
      blog: "Blog",
      portfolios: "Portfólios",
      about: "Sobre",
      contact: "Contato",
    }
  }
};

const lang = isPT ? t.pt : t.en;
const base = isPT ? '/pt' : '';
---

<footer class="site-footer">
  <div class="footer-inner">

    <div class="footer-brand">
      <p class="footer-name">Iara Santos</p>
      <p class="footer-tagline">{lang.tagline}</p>
      <p class="footer-location">{lang.location}</p>
    </div>

    <nav class="footer-nav" aria-label="Footer navigation">
      <a href={`${base}/`}>{lang.nav.blog}</a>
      <a href={`${base}/portfolios`}>{lang.nav.portfolios}</a>
      <a href={`${base}/about`}>{lang.nav.about}</a>
      <a href={`${base}/contact`}>{lang.nav.contact}</a>
    </nav>

    <div class="footer-social">
      <a
        href="https://www.instagram.com/iara_interiordesigner"
        target="_blank"
        rel="noopener noreferrer"
        class="social-link instagram"
        aria-label="Instagram"
      >
        <svg class="social-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
          <circle cx="12" cy="12" r="4"/>
          <circle cx="17.5" cy="6.5" r="0.5" fill="currentColor" stroke="none"/>
        </svg>
        <span class="social-handle">@iara_interiordesigner</span>
      </a>

      <a
        href="https://linkedin.com/in/arqiarassantos"
        target="_blank"
        rel="noopener noreferrer"
        class="social-link linkedin"
        aria-label="LinkedIn"
      >
        <svg class="social-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
        </svg>
        <span class="social-handle">arqiarassantos</span>
      </a>
    </div>

  </div>

  <div class="footer-bottom">
    <p>© {new Date().getFullYear()} Iara Santos. {lang.rights}</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-sand);
    padding: 3rem 0 1.5rem;
    margin-top: 5rem;
    font-family: var(--font-sans, 'Inter', sans-serif);
  }

  .footer-inner {
    max-width: var(--content-width, 1100px);
    margin: 0 auto;
    padding: 0 2rem;
    display: grid;
    grid-template-columns: 1fr auto auto;
    gap: 3rem;
    align-items: start;
  }

  /* Brand */
  .footer-name {
    font-family: var(--font-serif, 'Cormorant Garamond', serif);
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--color-ink, #1A1815);
    margin: 0 0 0.35rem;
    letter-spacing: 0.02em;
  }

  .footer-tagline {
    font-size: 0.8rem;
    color: var(--color-charcoal, #3A3530);
    margin: 0 0 0.25rem;
    font-style: italic;
  }

  .footer-location {
    font-size: 0.75rem;
    color: var(--color-bronze, #8B7355);
    margin: 0;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  /* Nav */
  .footer-nav {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer-nav a {
    font-size: 0.8rem;
    color: var(--color-charcoal, #3A3530);
    text-decoration: none;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    transition: color 0.2s ease;
  }

  .footer-nav a:hover {
    color: var(--color-bronze, #8B7355);
  }

  /* Social */
  .footer-social {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    align-items: flex-start;
  }

  .social-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--color-charcoal, #3A3530);
    transition: color 0.2s ease;
  }

  .social-link:hover {
    color: var(--color-bronze, #8B7355);
  }

  .social-icon {
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
  }

  .social-handle {
    font-size: 0.78rem;
    letter-spacing: 0.01em;
  }

  /* Bottom strip */
  .footer-bottom {
    max-width: var(--content-width, 1100px);
    margin: 2rem auto 0;
    padding: 1.25rem 2rem 0;
    border-top: 1px solid var(--color-sand, #D4C5B0);
  }

  .footer-bottom p {
    font-size: 0.72rem;
    color: var(--color-charcoal, #3A3530);
    margin: 0;
    opacity: 0.7;
  }

  /* Responsive */
  @media (max-width: 680px) {
    .footer-inner {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>
