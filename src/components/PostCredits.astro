---
import type { Locale } from '../i18n/ui';

interface CreditItem {
  label: string;
  value: string;
  url?: string;
}

interface Props {
  locale: Locale;
  items: CreditItem[];
  title?: string;
}

const { locale, items, title } = Astro.props;
const label = title ?? (locale === 'pt' ? 'Créditos' : 'Credits');
---

<section class="post-credits">
  <h2 class="eyebrow">{label}</h2>
  <dl>
    {items.map((item) => (
      <>
        <dt>{item.label}</dt>
        <dd>
          {item.url ? (
            <a href={item.url} rel="noopener">{item.value}</a>
          ) : (
            item.value
          )}
        </dd>
      </>
    ))}
  </dl>
</section>

<style>
  .post-credits {
    max-width: 64rem;
    margin: clamp(3rem, 7vh, 4.5rem) auto 0;
    padding: 0 var(--gutter);
  }
  .post-credits h2 {
    margin: 0 0 1.6rem;
    padding-top: 1.6rem;
    border-top: 1px solid var(--sand);
    font-family: var(--font-sans);
    font-size: var(--fs-meta);
    font-weight: 500;
  }
  dl {
    display: grid;
    grid-template-columns: 11rem 1fr;
    gap: 0.85rem 2rem;
    margin: 0;
    max-width: 46rem;
  }
  dt {
    font-family: var(--font-sans);
    font-size: var(--fs-meta);
    text-transform: uppercase;
    letter-spacing: var(--tracking-mid);
    color: var(--ink-muted);
    padding-top: 0.2rem;
  }
  dd {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--ink-soft);
  }
  @media (max-width: 620px) {
    dl { grid-template-columns: 1fr; gap: 0.15rem 0; }
    dd { margin-bottom: 1rem; }
  }
</style>
